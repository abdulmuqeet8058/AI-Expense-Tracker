# Copy to .env and adjust for running the backend locally.

# --- Mongo ---
MONGODB_URI=mongodb://localhost:27017
DB_NAME=expense_tracker

# --- Auth ---
# CHANGE THIS in prod. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# "*" for any origin, or a comma-separated list e.g. http://localhost:8080,http://localhost:3000
CORS_ORIGINS=*
